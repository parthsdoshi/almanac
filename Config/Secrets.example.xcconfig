// Copy to Config/Secrets.xcconfig (gitignored) and fill in.
// Team ID: developer.apple.com/account > Membership details.
DEVELOPMENT_TEAM = ABCDE12345
// Must be unique to you. The server's APNS_BUNDLE_ID must match exactly.
APP_BUNDLE_ID = com.yourname.occasions
// Your Render service's host, e.g. occasions-push-abcd.onrender.com (no https://).
// Leave empty to run without the server: reminders still work, but the day-of
// Live Activity only appears when you open the app that day.
OCCASIONS_SERVER_HOST =
// The API_KEY value Render generated for the service.
OCCASIONS_API_KEY =
